# Port the MCP ingest server listens on. It falls back to 7475 then 7476 when busy.
# NORTHSTAR_PORT=7474

# Absolute path to the project root where .northstar/ comments are stored.
# Defaults to the current working directory when the MCP server starts.
# NORTHSTAR_ROOT=/path/to/your/project

# Force a terminal driver instead of detecting one: tmux, iterm, terminal-app, or none.
# NORTHSTAR_TERMINAL=tmux

# Set to 0 to stop Send to AI from typing into your terminal.
# NORTHSTAR_INJECT=1
