{
  "name": "@northstar/extension",
  "version": "1.0.0",
  "description": "Chromium MV3 extension to leave real-time comments on any interface and route them to a local AI coding assistant.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && cd dist && zip -qr -FS ../northstar-extension.zip . -x '*.DS_Store' '*.map' && cd ..",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/dompurify": "^3.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.45.8",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6"
  }
}
