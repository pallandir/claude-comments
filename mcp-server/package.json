{
  "name": "@claude-comments/mcp-server",
  "version": "0.1.0",
  "description": "MCP server that ingests UI comments from the Claude Comments extension and exposes them to Claude Code.",
  "type": "module",
  "bin": {
    "claude-comments-mcp": "dist/index.js"
  },
  "files": ["dist"],
