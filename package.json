{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Right-click comments on any local frontend, picked up by Claude Code through an MCP server.",
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": ["extension", "mcp-server"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  }
}
